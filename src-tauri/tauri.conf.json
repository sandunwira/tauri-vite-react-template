{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "appname",
	"version": "0.1.0",
	"identifier": "com.developer.appname",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist",
		"features": []
	},
	"app": {
		"windows": [
			{
				"title": "App Name",
				"label": "main",
				"minWidth": 1100,
				"width": 1200,
				"maxWidth": 1600,
				"minHeight": 600,
				"height": 700,
				"maxHeight": 700,
				"dragDropEnabled": false,
				"center": true,
				"focusable": true,
				"focus": true,
				"decorations": true,
				"backgroundColor": "#18181B"
			}
		],
		"withGlobalTauri": true,
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Developer Name",
		"copyright": "2026 © Developer Name",
		"category": "Utility",
		"homepage": "https://github.com/username/repo",
		"longDescription": "App Name",
		"shortDescription": "App Description",
		"license": "MIT",
		"targets": [
			"msi"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"allowDowngrades": false,
			"certificateThumbprint": null,
			"digestAlgorithm": null,
			"nsis": null,
			"signCommand": null,
			"timestampUrl": null,
			"tsp": false,
			"webviewInstallMode": {
				"silent": true,
				"type": "downloadBootstrapper"
			}
		},
		"resources": []
	}
}